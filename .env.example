# TTJobs production environment template.
# Copy to .env and replace every CHANGE_ME value before deploying.

# Docker image namespace used by docker-compose.images.yml.
DOCKER_USER=CHANGE_ME_DOCKERHUB_USER
IMAGE_TAG=1.0.0

# Public URL.
# Use https in production because camera/microphone APIs require a secure context.
TTJOBS_PUBLIC_URL=https://CHANGE_ME_DOMAIN
TTJOBS_APP_BASE_URL=https://CHANGE_ME_DOMAIN
TTJOBS_CORS_ALLOWED_ORIGINS=https://CHANGE_ME_DOMAIN

# Frontend build-time flags.
# Keep demo fallback off in production so public pages show real empty/error states.
VITE_ENABLE_DEMO_FALLBACK=false

# PostgreSQL.
POSTGRES_DB=ttjobs
POSTGRES_USER=ttjobs
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

# JWT.
# Must be at least 32 ASCII characters for HS256 signing.
# Must be at least 32 ASCII chars / 256 bits for HS256 JWT signing.
JWT_SECRET=CHANGE_ME_USE_A_RANDOM_SECRET_AT_LEAST_64_ASCII_CHARACTERS_LONG

# Redis realtime broker for messenger, forum, notifications, and interview events.
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
TTJOBS_REALTIME_REDIS_ENABLED=true
TTJOBS_REALTIME_REDIS_CHANNEL=ttjobs:realtime

# AI service model paths inside the ai-service container.
CATEGORY_MODEL_DIR=/app/models/category-classifier
MATCH_CLASSIFIER_MODEL_DIR=/app/models/cv-jd-matcher
MATCHER_MODEL_DIR=/app/cv-job-matcher
TTJOBS_AI_BASE_URL=http://ai-service:8000

# Optional LLM provider for AI normalize.
# Example OpenAI-compatible endpoint: https://api.openai.com/v1/chat/completions
# Leave blank to use rule-based fallback only.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Email.
# Set true only after SMTP credentials are valid.
TTJOBS_EMAIL_ENABLED=false
TTJOBS_EMAIL_FROM=no-reply@CHANGE_ME_DOMAIN
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS_ENABLE=true

# Cloudinary image upload.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional pgAdmin. Do not expose publicly without a firewall/VPN.
PGADMIN_DEFAULT_EMAIL=admin@CHANGE_ME_DOMAIN
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_STRONG_PGADMIN_PASSWORD
